<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/background"
    android:padding="16dp">

    <!-- Top App Bar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:menu="@menu/top_app_bar_menu" />
    <include
        android:id="@+id/settingsPanel"
        layout="@layout/activity_settings_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
    <!-- Welcome -->

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:fontFamily="@font/poppins_thin"
        android:text="@string/name"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ROOM CARD (duplicate per room) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                android:backgroundTint="#AA3E2723">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Room name -->
                    <TextView
                        android:id="@+id/livingRoomCard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/living"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:fontFamily="@font/poppins_thin"
                        android:layout_marginBottom="10dp"/>

                    <!-- Content row: Switches (left) + Sensors (right) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <!-- Switch column -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="25dp"
                            android:layout_marginEnd="23dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/light"
                                android:textColor="@android:color/white"
                                android:fontFamily="@font/poppins_regular"/>
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switchlivingLight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:showText="false"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/fan"
                                android:textColor="@android:color/white"
                                android:fontFamily="@font/poppins_regular"/>
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switchlivingFan"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:showText="false"/>
                        </LinearLayout>

                        <!-- Sensors area -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <!-- Fire -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginTop="20dp"
                                android:orientation="vertical"
                                android:gravity="center_horizontal"
                                tools:ignore="NestedWeights">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/fire"
                                    android:textColor="@android:color/white"
                                    android:fontFamily="@font/poppins_regular"/>
                                <TextView
                                    android:id="@+id/livingroomFire"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/value"
                                    android:textColor="@android:color/white"
                                    android:layout_marginTop="4dp"
                                    android:fontFamily="@font/poppins_thin"/>
                            </LinearLayout>

                            <!-- Smoke -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginTop="20dp"
                                android:orientation="vertical"
                                android:gravity="center_horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/smoke"
                                    android:textColor="@android:color/white"
                                    android:fontFamily="@font/poppins_regular"/>
                                <TextView
                                    android:id="@+id/livingSmoke"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/value"
                                    android:textColor="@android:color/white"
                                    android:layout_marginTop="4dp"
                                    android:fontFamily="@font/poppins_thin"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ROOM CARD (duplicate per room) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                android:backgroundTint="#AA3E2723">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

            <!-- Room name -->

                    <!-- Content row: Switches (left) + Sensors (right) -->
                    <TextView
