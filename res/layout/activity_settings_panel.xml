<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#CC3E2723"
    android:layout_marginTop="60dp"
    android:layout_marginStart="16dp"
    android:layout_marginBottom="16dp"
    android:elevation="8dp"
    android:clipToPadding="false">

    <!-- Profile (Name Section) -->
    <TextView
        android:id="@+id/PName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="12dp"
        android:gravity="center_vertical"
        android:text="@string/profile_name"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:fontFamily="@font/poppins_regular"
        android:paddingBottom="16dp"
        android:contentDescription="@string/desc_profile_icon"
        app:drawableStartCompat="@drawable/ic_profile" />

    <!-- Manage Fingerprint (Converted to TextView with drawableStart) -->
    <TextView
        android:id="@+id/fingerprint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:text="@string/manage_f"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:fontFamily="@font/poppins_regular"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/desc_fingerprint_icon"
        app:drawableStartCompat="@drawable/ic_fingerprint" />

    <TextView
        android:id="@+id/camimg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:text="@string/imgcam"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:fontFamily="@font/poppins_regular"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/desc_fingerprint_icon"
        app:drawableStartCompat="@drawable/ic_fingerprint" />

    <!-- Logout (Converted to TextView with drawableStart) -->
    <TextView
        android:id="@+id/logout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:text="@string/logout"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:fontFamily="@font/poppins_regular"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/desc_logout_icon"
        app:drawableStartCompat="@drawable/ic_logout" />

</LinearLayout>
